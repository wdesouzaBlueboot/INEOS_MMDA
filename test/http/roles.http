### =========================================================================
### GLOBAL VARIABLES AND CREDENTIALS
### =========================================================================
@baseUrl = http://localhost:4004/odata/v4/catalog

@requestor = Basic requestor requestor
@reviewer = Basic reviewer revrevrev
@reviewer1 = Basic reviewer1 reviewer1
@reviewer1_1 = Basic reviewer1_1 reviewer1_1
@reviewer2 = Basic reviewer2 reviewer2
@reviewer3 = Basic reviewer3 reviewer3
@reviewer4 = Basic reviewer4 reviewer4
@rev1_3030 = Basic rev1_3030 rev1_3030
@rev2_3030 = Basic rev2_3030 rev2_3030
@rev3_3030 = Basic rev3_3030 rev3_3030
@rev4_3030 = Basic rev4_3030 rev4_3030
@rev5_3030 = Basic rev5_3030 rev5_3030
@rev1_3333 = Basic rev1_3333Auth rev1_3333Auth
@unassigned = Basic unassignedReviewer unassignedReviewer
@admin = Basic admin admin
@unauthorized = Basic unauthorized unauthorized

### =========================================================================
### 0. SETUP TEMPORARY HIERARCHY
### =========================================================================
### Execute these requests only once when starting the server to populate 
### the hierarchy table temporarily so the rest of the flows work properly.

### 3080 NewStock - Step 1
# @name rh1
POST {{baseUrl}}/ReviewHierarchy
Authorization: {{admin}}
Content-Type: application/json

{ "plant_Plant": "3080", "formType_code": "NewStock", "step": 1, "reviewer": "reviewer1@test.com" }

###
POST {{baseUrl}}/ReviewHierarchy(ID={{rh1.response.body.ID}},IsActiveEntity=false)/CatalogService.draftActivate
Authorization: {{admin}}
Content-Type: application/json

{}

