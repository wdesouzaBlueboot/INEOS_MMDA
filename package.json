          "model": "srv/external/material",
          "csrf": true,
          "csrfInBatch": true
        },
        "material2": {
          "kind": "app-service",
          "model": "srv/external/material2"
        },
        "materialMasterBAPI": {
          "kind": "app-service",
          "model": "srv/external/materialMasterBAPI"
        },
        "saveMaterialDataBAPI": {
          "kind": "app-service",
          "model": "srv/external/saveMaterialDataBAPI"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "malware-scanner": true,
